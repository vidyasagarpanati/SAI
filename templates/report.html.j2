<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archery Biomechanics Report - {{ v.athlete_name }}</title>
<style>
:root{--ink:#1d2330;--muted:#5d6678;--line:#dfe3ea;--bg:#f6f7fa;--card:#fff;--accent:#1f4e79;
--hi:#1e7d4f;--me:#b7791f;--lo:#b8322a;--chip:#eef1f6}
*{box-sizing:border-box}
body{margin:0;font:15px/1.55 -apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--bg)}
header.top{background:linear-gradient(120deg,#12324f,#1f4e79);color:#fff;padding:28px 32px}
header.top h1{margin:0 0 4px;font-size:24px;letter-spacing:.3px}
header.top .sub{opacity:.85;font-size:13px}
nav{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid var(--line);overflow-x:auto;white-space:nowrap;padding:6px 16px}
nav a{display:inline-block;padding:6px 9px;margin:2px;border-radius:6px;color:var(--accent);text-decoration:none;font-size:12.5px}
nav a:hover{background:var(--chip)}
main{max-width:1180px;margin:0 auto;padding:20px 16px 60px}
section{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:20px 24px;margin:18px 0}
section h2{margin:0 0 12px;font-size:19px;color:var(--accent);border-bottom:2px solid var(--line);padding-bottom:8px}
section h3{font-size:16px;margin:18px 0 8px}
table{border-collapse:collapse;width:100%;margin:8px 0 14px;font-size:13.5px}
th,td{border:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top}
th{background:#f0f3f8;font-weight:600}
td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
.chip{display:inline-block;font-size:11px;font-weight:600;padding:1px 7px;border-radius:10px;background:var(--chip);color:#334;margin-right:4px}
.c-HIGH{background:#e3f4ec;color:var(--hi)}.c-MEDIUM{background:#fbf1de;color:var(--me)}.c-LOW{background:#fbe6e4;color:var(--lo)}
.sev-CRITICAL{background:#fbe6e4;color:var(--lo)}.sev-MODERATE{background:#fbf1de;color:var(--me)}.sev-MINOR{background:#eef1f6;color:#445}
.na{color:var(--muted);font-style:italic}
.kv{display:grid;grid-template-columns:260px 1fr;gap:4px 14px}
.kv div:nth-child(odd){color:var(--muted)}
.frame{margin:10px 0 16px}
.frame img{width:100%;height:auto;border-radius:6px;border:1px solid var(--line)}
.frame .cap{font-size:12.5px;color:var(--muted);margin-top:4px}
.noframe{background:#eceff3;border:1px dashed #b9c0cc;color:#5a6270;text-align:center;padding:38px 12px;border-radius:6px;font-weight:600;margin:10px 0}
.na-box{background:#fdf3f2;border:1px solid #f0c5c0;border-radius:8px;padding:18px;margin:8px 0}
.na-box b{color:var(--lo)}
.banner{background:#fff4e5;border:1px solid #f0d3a5;border-left:6px solid var(--me);border-radius:8px;padding:14px 18px;margin:18px 0}
.phase{border-left:6px solid var(--accent);padding-left:14px;margin:22px 0}
.prio{border:1px solid var(--line);border-radius:8px;padding:12px 16px;margin:12px 0}
.score{font-weight:700;font-size:15px}
.cue{font-size:18px;font-weight:600;color:var(--accent)}
footer{color:var(--muted);font-size:12px;text-align:center;margin-top:30px}
nav{display:flex;align-items:center;gap:2px}
nav button{margin-left:auto;font:600 12.5px inherit;font-family:inherit;color:#fff;background:var(--accent);border:0;border-radius:6px;padding:7px 12px;cursor:pointer;white-space:nowrap}
main{max-width:960px}
section{padding:18px 22px;margin:12px 0;scroll-margin-top:52px}
.group{font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin:30px 2px 6px;scroll-margin-top:52px}
.sec-head{display:flex;align-items:center;gap:10px}
.sec-head h2{border:0;margin:0;padding:0;font-size:17px;flex:1}
.n{flex:none;width:26px;height:26px;line-height:26px;border-radius:50%;text-align:center;background:var(--chip);color:var(--accent);font-size:12.5px;font-weight:700}
.pill{flex:none;font-size:12px;font-weight:600;padding:3px 10px;border-radius:12px;background:var(--chip);color:#334}
.pill.warn,.pill.conf-MEDIUM{background:#fbf1de;color:var(--me)}.pill.ok,.pill.conf-HIGH{background:#e3f4ec;color:var(--hi)}.pill.conf-LOW{background:#fbe6e4;color:var(--lo)}.pill.mute{color:var(--muted)}
.sum{margin-top:8px}
.head{font-size:15.5px;font-weight:600;margin:6px 0 8px}.head.dim{font-weight:400;color:var(--muted)}
.muted{color:var(--muted);font-size:13px;margin:8px 0 0}
.pts{margin:6px 0;padding-left:20px}.pts li{margin:3px 0}
.ref{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:10px;background:var(--chip);color:var(--accent);text-decoration:none}
.ref:hover{background:#dbe3ee}
details{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
summary{cursor:pointer;color:var(--accent);font-weight:600;font-size:13.5px}
.deep{margin-top:10px;overflow-x:auto}
.care{background:#fff8ec;border-left:4px solid var(--me);border-radius:4px;padding:8px 12px;font-size:13.5px;margin:10px 0 0}
table.mini{font-size:13.5px;margin:6px 0}table.mini th,table.mini td{border-width:0 0 1px;background:none;padding:6px 8px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin:8px 0}
.tile{background:var(--bg);border-radius:8px;padding:8px 12px}.tile b{display:block;font-size:16px}.tile span{font-size:12px;color:var(--muted)}
.bars{margin:8px 0}.bar{display:grid;grid-template-columns:190px 1fr 52px;gap:10px;align-items:center;padding:3px 0;font-size:13.5px}
.bar .track{height:8px;background:var(--chip);border-radius:4px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);border-radius:0 4px 4px 0}
.bar .val{text-align:right;font-weight:600;font-variant-numeric:tabular-nums}
.bar.low{font-weight:700}.bar.none{color:var(--muted)}.bar.none .track{background:none;border-top:1px dashed var(--line);height:0}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:8px}
.pcard{display:block;border:1px solid var(--line);border-radius:8px;overflow:hidden;color:inherit;text-decoration:none}
.pcard:hover{border-color:var(--accent)}.pcard img{display:block;width:100%;height:auto}
.pn{display:flex;justify-content:space-between;gap:6px;padding:7px 10px 0;font-size:13.5px}.ps{font-weight:700;white-space:nowrap}
.pcard p{margin:2px 10px 9px;font-size:12.5px;color:var(--muted);line-height:1.4}
.stack{display:flex;gap:2px;height:12px;margin:8px 0}.stack i{border-radius:2px}
.s-HIGH{background:var(--hi)}.s-MEDIUM{background:var(--me)}.s-LOW{background:var(--lo)}
.legend{display:flex;gap:16px;font-size:13px}.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px}
.coach{border:2px solid var(--accent)}.coach h3{margin:0 0 6px;font-size:14.5px}
.hero{display:flex;gap:18px;align-items:stretch}
.big{flex:none;text-align:center;padding:8px 18px;background:var(--bg);border-radius:10px}
.big b{font-size:44px;line-height:1;color:var(--accent)}.big span{font-size:18px;color:var(--muted)}.big small{display:block;font-size:12px;color:var(--muted)}
.cue-box{flex:1;background:var(--accent);color:#fff;border-radius:10px;padding:12px 18px;display:flex;flex-direction:column;justify-content:center}
.cue-box small{opacity:.8}.cue-box p{margin:2px 0 0;font-size:20px;font-weight:600;line-height:1.3}
.limit{background:#fff8ec;border-radius:8px;padding:9px 13px;font-size:13.5px;margin:12px 0}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.two ol{margin:0;padding-left:20px;font-size:14px}.two li{margin:4px 0}
.good,.fix{border:1px solid var(--line);border-radius:8px;padding:11px 14px}.good h3{color:var(--hi)}.fix h3{color:var(--lo)}
.one{background:var(--bg);border-radius:8px;padding:10px 14px;margin:12px 0 16px}.one small{color:var(--muted)}.one p{margin:2px 0 0;font-weight:600}
@media (max-width:720px){.kv{grid-template-columns:1fr}header.top{padding:20px 16px}section{padding:16px}.pgrid{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.hero{flex-direction:column}.bar{grid-template-columns:130px 1fr 46px}}
@media print{nav,summary{display:none}section{break-inside:auto}.sum,.coach{break-inside:avoid}}
</style>
</head>
<body>
{% macro conf(c) %}{% if c %}<span class="chip c-{{ c }}">{{ c }}</span>{% endif %}{% endmacro %}
{% macro lvl(l) %}{% if l %}<span class="chip">[{{ l }}]</span>{% endif %}{% endmacro %}
{% macro txt(t) %}{% if t is none or t == "" %}<span class="na">Not available from supplied video.</span>{% elif "NOT RELIABLY ASSESSABLE" in t or "NOT PROVIDED" in t %}<span class="na">{{ t }}</span>{% else %}{{ t }}{% endif %}{% endmacro %}
{% macro score(s) %}{% if s is none %}<span class="na">NOT RELIABLY ASSESSABLE</span>{% else %}<span class="score">{{ s }}/10</span>{% endif %}{% endmacro %}
{% macro ref(r) %}{% if r and r != "NOT ESTABLISHED" %}<a class="ref" href="#{{ r }}">{{ r }}</a>{% endif %}{% endmacro %}
{% macro cell(c) %}{% if c is mapping %}{% if c.ref %}{{ ref(c.ref) }}{% else %}<span class="chip {{ c.cls }}">{{ c.text }}</span>{% endif %}{% else %}{{ c }}{% endif %}{% endmacro %}
{% macro bars(rows) %}<div class="bars">{% for b in rows %}{% if b.score is none %}<div class="bar none"><span>{{ b.label }}</span><span class="track"></span><span class="val">n/a</span></div>{% else %}<div class="bar{{ ' low' if b.low }}" title="{{ b.label }}: {{ b.score }}/10"><span>{{ b.label }}</span><span class="track"><i style="width:{{ b.score * 10 }}%"></i></span><span class="val">{{ b.score }}/10</span></div>{% endif %}{% endfor %}</div>{% endmacro %}
{% macro section_head(number, title, e) %}<div class="sec-head">{% if number %}<span class="n">{{ number }}</span>{% endif %}<h2>{{ title }}</h2>{% if e.pill %}<span class="pill {{ e.pill[1] }}">{{ e.pill[0] }}</span>{% endif %}</div>{% endmacro %}
{% macro summary_of(e) %}<div class="sum">
  {% if e.head %}<p class="head{{ ' dim' if e.dim }}">{{ e.head }}</p>{% endif %}
  {% if e.points %}<ul class="pts">{% for p in e.points %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}
  {% if e.tiles %}<div class="tiles">{% for val, label in e.tiles %}<div class="tile"><b>{{ val }}</b><span>{{ label }}</span></div>{% endfor %}</div>{% endif %}
  {% if e.grid %}<div class="pgrid">{% for g in e.grid %}{% if g.detected %}<a class="pcard" href="#ph-{{ g.code }}">{% if g.thumb %}<img alt="Key frame, {{ g.name }}" src="data:image/jpeg;base64,{{ g.thumb }}">{% endif %}<div class="pn"><b>{{ loop.index }}. {{ g.name }}</b>{% if g.score is not none %}<span class="ps">{{ g.score }}/10</span>{% endif %}</div><p>{{ g.take }}</p></a>{% else %}<div class="pcard"><div class="pn"><b>{{ loop.index }}. {{ g.name }}</b></div><p>Not found in this video.</p></div>{% endif %}{% endfor %}</div>{% endif %}
  {% if e.table and e.table.rows %}<table class="mini"><tr>{% for h in e.table.head %}<th>{{ h }}</th>{% endfor %}</tr>{% for row in e.table.rows %}<tr>{% for c in row %}<td>{{ cell(c) }}</td>{% endfor %}</tr>{% endfor %}</table>{% endif %}
  {% if e.bars %}{{ bars(e.bars) }}{% endif %}
  {% if e.stack %}<div class="stack" title="{% for l, c in e.stack %}{{ l }} {{ c }} {% endfor %}">{% for l, c in e.stack %}{% if c %}<i class="s-{{ l }}" style="flex:{{ c }}"></i>{% endif %}{% endfor %}</div><div class="legend">{% for l, c in e.stack %}<span><i class="s-{{ l }}"></i>{{ l }} {{ c }}</span>{% endfor %}</div>{% endif %}
  {% if e.muted %}<p class="muted">{{ e.muted }}</p>{% endif %}
  {% if e.care %}<p class="care"><b>&#9888; Read with care:</b> {{ e.care }}</p>{% endif %}
</div>{% endmacro %}

<header class="top">
  <h1>Archery Coach Report</h1>
  <div class="sub">{{ v.athlete_name }} &middot; {{ v.session_date }} &middot; report {{ v.version_label }} &middot; run {{ v.run_id }}</div>
</header>
<nav>{% if v.coach %}<a href="#coach">Coach's Page</a>{% endif %}{% for g in v.groups %}<a href="#g-{{ g|replace(' ', '-') }}">{{ g }}</a>{% endfor %}<button id="toggle" type="button">Expand all</button></nav>
<main>
{% if v.partial %}
<div class="banner"><b>PARTIAL REPORT.</b> {{ v.failed|length }} section(s) could not be produced
and are marked NOT AVAILABLE below, with the reason. Every other section is complete and verified.
Nothing has been guessed to fill a gap. See Section 20 for the verification record.</div>
{% endif %}

{% if v.coach %}{% set c = v.coach %}
<section id="coach" class="coach">
  <div class="hero">
    {% if c.score is not none %}<div class="big"><b>{{ c.score }}</b><span>/10</span><small>Overall technique</small></div>{% endif %}
    <div class="cue-box"><small>Key coaching cue</small><p>"{{ c.cue }}"</p></div>
  </div>
  <p class="limit"><b>Before you read:</b> {{ c.limits|join(" ") }} Analysis confidence: {{ conf(c.confidence) }}</p>
  <div class="two">
    <div class="good"><h3>&#10003; Does well</h3><ol>{% for i in c.does_well %}<li>{{ i.text }} {{ ref(i.ref) }}</li>{% endfor %}</ol></div>
    <div class="fix"><h3>&#9650; Fix first</h3><ol>{% for i in c.fix_first %}<li>{{ i.text }} {{ ref(i.ref) }}{% if i.low %} <span class="chip c-LOW">Check on video</span>{% endif %}</li>{% endfor %}</ol></div>
  </div>
  <div class="one"><small>Single most important correction</small><p>{{ c.main_fix.text }} {{ ref(c.main_fix.ref) }}</p></div>
  {% if c.bars %}<h3>Score by step</h3>{{ bars(c.bars) }}{% endif %}
  <p class="muted">SW = shoulder widths. Every section below opens with a summary; use <b>Full analysis</b> to go deeper.</p>
</section>
{% endif %}

<section id="sec-info">
  {{ section_head("", "Athlete / Session Information", v.summaries.info) }}
  {{ summary_of(v.summaries.info) }}
  <details><summary>Full session details</summary><div class="deep">
  <div class="kv">{% for k, val in v.info %}<div>{{ k }}</div><div>{{ txt(val) }}</div>{% endfor %}</div>
  <h3>Basic Athlete &amp; Session Information</h3>
  <table><tr><th>Field</th><th>Value (or "NOT PROVIDED")</th></tr>
  {% for k, val in v.pre_basic %}<tr><td>{{ k }}</td><td>{{ txt(val) }}</td></tr>{% endfor %}</table>
  <h3>Video-Specific Metadata</h3>
  <table><tr><th>Field</th><th>Value (or "NOT PROVIDED")</th></tr>
  {% for k, val in v.pre_video %}<tr><td>{{ k }}</td><td>{{ txt(val) }}</td></tr>{% endfor %}</table>
  <p><b>Additional Data Available:</b> {% if v.additional %}{{ v.additional|join("; ") }}{% else %}<span class="na">NOT PROVIDED - CANNOT BE CONFIRMED</span>{% endif %}</p>
  </div></details>
</section>

{% for s in v.order %}
{% if loop.changed(s.group) %}<div class="group" id="g-{{ s.group|replace(' ', '-') }}">{{ s.group }}</div>{% endif %}
{% set k = s.key %}
<section id="sec-{{ s.key }}">
{{ section_head(s.number, s.title|title, v.summaries[k]) }}
{{ summary_of(v.summaries[k]) }}
<details{{ ' open' if v.failed.get(k) }}><summary>Full analysis</summary><div class="deep">

{% if v.failed.get(k) %}
  <div class="na-box"><b>NOT AVAILABLE (section failed).</b>
  This section could not be produced after all attempts. Reason: {{ v.failed[k] }}.
  It is left empty rather than filled with unverified content. Rerun with
  <code>archery run --video &lt;path&gt; --from S8</code> to try again.</div>

{% elif k == "s01" %}{% set e = v.n.s01_executive %}
  <table>
  <tr><th style="width:32%">Estimated technical level</th><td>{{ txt(e.technical_level) }}</td></tr>
  <tr><th>Overall technique score</th><td>{{ score(v.overall_score) }} <span class="na">(from Section 12)</span></td></tr>
  <tr><th>Strongest technical characteristic</th><td>{{ e.strongest_characteristic.text }} <span class="chip">{{ e.strongest_characteristic.ref }}</span></td></tr>
  <tr><th>Most important weakness</th><td>{{ e.most_important_weakness.text }} <span class="chip">{{ e.most_important_weakness.ref }}</span></td></tr>
  <tr><th>Main consistency limitation</th><td>{{ txt(e.main_consistency_limitation) }}</td></tr>
  <tr><th>Main biomechanical limitation</th><td>{{ txt(e.main_biomechanical_limitation) }}</td></tr>
  <tr><th>Main injury-risk factor</th><td>{{ txt(e.main_injury_risk_factor) }}</td></tr>
  <tr><th>Most important correction</th><td>{{ e.most_important_correction.text }} <span class="chip">{{ e.most_important_correction.ref }}</span></td></tr>
  <tr><th>Expected improvement opportunity</th><td>{{ txt(e.expected_improvement_opportunity) }}</td></tr>
  </table>

{% elif k == "s02" %}{% set q = v.n.s02_quality %}
  <table>{% for label, val in v.quality_rows %}<tr><th style="width:32%">{{ label }}</th><td>{{ txt(val) }}</td></tr>{% endfor %}
  {% for f in ["camera_angle","lighting","athlete_visibility","occlusion","motion_blur","clothing_interference"] %}
  <tr><th>{{ f|replace("_"," ")|capitalize }}</th><td>{{ txt(q[f]) }}</td></tr>{% endfor %}</table>
  <p><b>OVERALL ANALYSIS CONFIDENCE:</b> {{ conf(v.overall_conf) }} <span class="na">{{ v.overall_rule }}</span></p>
  <h3>Limitations</h3><ul>{% for l in q.limitations %}<li>{{ l }}</li>{% endfor %}</ul>

{% elif k == "s03" %}
  <table><tr><th>Shot</th><th>Timestamp</th><th>Phase</th><th>Observation</th><th>Measurement</th><th>Interpretation</th><th>Confidence</th></tr>
  {% for r in v.frame_rows %}<tr><td>{{ r.shot }}</td><td class="num">{{ r.ts }}</td><td>{{ r.phase }}</td>
  <td>{{ lvl(r.level) }}{{ txt(r.observation) }}</td><td>{{ r.measurement }}</td><td>{{ txt(r.interpretation) }}</td><td>{{ conf(r.confidence) }}</td></tr>{% endfor %}</table>

{% elif k == "s04" %}
  {% for p in v.phases %}
  <div class="phase" style="border-color:{{ p.color }}">
    <h3 id="ph-{{ p.code }}">Phase {{ p.badge }}: {{ p.name }}</h3>
    {% if p.detected and p.failed %}
      <div class="na-box"><b>ANALYSIS NOT AVAILABLE.</b> The phase was extracted and measured, but
      its written analysis could not be produced. Reason: {{ p.failed }}.</div>
      <p class="na">{{ p.timing }}</p>
      {% for f in p.frames %}<div class="frame"><img alt="Annotated key frame, shot {{ f.shot }}, {{ p.name }}" src="data:image/jpeg;base64,{{ f.b64 }}"><div class="cap">Shot {{ f.shot }} &middot; t = {{ f.t }} s &middot; frame {{ f.frame }}</div></div>{% endfor %}
    {% elif p.detected %}
      <p class="na">{{ p.timing }} &middot; criteria applied: {{ p.criteria|join(", ") }}</p>
      <ul>{% for a in p.analysis %}<li>{{ lvl(a.evidence_level) }}{{ conf(a.confidence) }} {{ txt(a.point) }}</li>{% endfor %}</ul>
      {% for f in p.frames %}<div class="frame"><img alt="Annotated key frame, shot {{ f.shot }}, {{ p.name }}" src="data:image/jpeg;base64,{{ f.b64 }}"><div class="cap">Shot {{ f.shot }} &middot; t = {{ f.t }} s &middot; frame {{ f.frame }}</div></div>{% endfor %}
      <p><b>Coaching implication:</b> {{ txt(p.coaching) }}</p>
    {% else %}
      <div class="noframe">[ANNOTATED FRAME NOT AVAILABLE]</div>
      <p class="na">Phase not extracted: {{ p.reason }}</p>
    {% endif %}
  </div>{% endfor %}

{% elif k == "s05" %}
  <h3>Full-draw (Aim phase) statistics</h3>
  <table><tr><th>Measure</th><th>Min</th><th>Max</th><th>Mean</th><th>Range</th><th>SD</th><th>Shot-to-shot SD</th><th>Confidence</th></tr>
  {% for r in v.stats_rows %}<tr><td>{{ r.name }}</td><td class="num">{{ r.min }}</td><td class="num">{{ r.max }}</td><td class="num">{{ r.mean }}</td><td class="num">{{ r.range }}</td><td class="num">{{ r.sd }}</td><td>{{ r.xsd }}</td><td>{{ conf(r.conf) }}</td></tr>{% endfor %}</table>

  <h3>Angle measurement space</h3>
  <p>Every joint angle is measured twice. The <b>image plane</b> value is what the
  joint subtends in the frame, in pixels, and is the value drawn on the annotated
  video and quoted throughout this report: it is the only one a reader can check
  against the picture. The <b>world</b> value is the same angle in the pose model's
  3D landmarks, whose depth is inferred from a single camera. Where the two
  disagree the joint is not square to the camera, the projected angle is
  foreshortened, and its confidence is dropped to LOW.</p>
  <table><tr><th>Joint</th><th>Image plane (2D)</th><th>World (3D)</th><th>Gap</th><th>Flag</th><th>Confidence</th></tr>
  {% for r in v.angle_space_rows %}<tr><td>{{ r.name }}</td><td class="num">{{ r.two_d }}</td>
    <td class="num">{{ r.three_d }}</td><td class="num">{{ r.gap }}</td>
    <td>{% if r.flag %}<span class="chip c-LOW">{{ r.flag }}</span>{% endif %}</td>
    <td>{{ conf(r.conf) }}</td></tr>{% endfor %}
  {% if not v.angle_space_rows %}<tr><td colspan="6" class="na">No aim-phase angles were measured.</td></tr>{% endif %}
  </table>
  <h3>Interpretation</h3>
  <ul>{% for f in v.n.s05_biomech.findings %}<li><b>{{ f.topic }}:</b> {{ lvl(f.evidence_level) }}{{ conf(f.confidence) }} {{ txt(f.finding) }}</li>{% endfor %}</ul>

{% elif k == "s06" %}
  <h3>Phase timing across shots</h3>
  <table><tr><th>Phase</th><th>Shots</th><th>Durations (s)</th><th>Mean</th><th>SD</th><th>CV</th></tr>
  {% for r in v.timing_rows %}<tr><td>{{ r.phase }}</td><td class="num">{{ r.n }}</td><td>{{ r.durations }}</td><td class="num">{{ r.mean }}</td><td class="num">{{ r.sd }}</td><td class="num">{{ r.cv }}</td></tr>{% endfor %}</table>
  <table>{% for label, val in v.rankings %}<tr><th style="width:32%">{{ label }}</th><td>{{ txt(val) }}</td></tr>{% endfor %}</table>
  <h3>Likely effects</h3>
  <table><tr><th>Aspect</th><th>Explanation</th><th>Confidence</th></tr>
  {% for e in v.n.s06_consistency.effects %}<tr><td>{{ e.aspect }}</td><td>{{ txt(e.explanation) }}</td><td>{{ conf(e.confidence) }}</td></tr>{% endfor %}</table>
  <p>{{ txt(v.n.s06_consistency.notes) }}</p>

{% elif k == "s07" %}
  <table><tr><th>Variable</th><th>Athlete Measurement</th><th>Reference/Target</th><th>Difference</th><th>Interpretation</th><th>Confidence</th></tr>
  {% for r in v.bench_rows %}<tr><td>{{ r.variable }}</td><td class="num">{{ r.athlete }}</td><td>{{ r.reference }}</td><td class="num">{{ r.diff }}</td><td>{{ r.interp }}</td><td>{{ conf(r.conf) }}</td></tr>{% endfor %}</table>
  {% if v.bench_rejected %}<p class="na">Benchmark entries excluded for lack of a citation: {{ v.bench_rejected|join("; ") }}</p>{% endif %}

{% elif k == "s08" %}
  <table><tr><th>Aspect</th><th>Classification</th><th>Observation</th><th>Confidence</th></tr>
  {% for i in v.n.s08_equipment["items"] %}<tr><td>{{ i.aspect }}</td><td><span class="chip">{{ i.classification }}</span></td><td>{{ txt(i.observation) }}</td><td>{{ conf(i.confidence) }}</td></tr>{% endfor %}</table>

{% elif k == "s09" %}
  {% if v.n.s09_errors.errors %}
  <table><tr><th>Rank</th><th>Error</th><th>Timestamp</th><th>Phase</th><th>Evidence</th><th>Cause</th><th>Biomechanical Effect</th><th>Performance Effect</th><th>Severity</th><th>Correction</th></tr>
  {% for e in v.n.s09_errors.errors|sort(attribute="rank") %}<tr><td>{{ e.rank }} <span class="chip" id="{{ e.id }}">{{ e.id }}</span></td><td>{{ e.error }}</td><td class="num">{{ e.timestamp }}</td><td>{{ e.phase }}</td><td>{{ txt(e.evidence) }} {{ conf(e.confidence) }}</td><td>{{ e.cause }}</td><td>{{ e.biomechanical_effect }}</td><td>{{ e.performance_effect }}</td><td><span class="chip sev-{{ e.severity }}">{{ e.severity }}</span></td><td>{{ e.correction }}</td></tr>{% endfor %}</table>
  {% else %}<p class="na">No significant technical errors could be established from the available evidence.</p>{% endif %}

{% elif k == "s10" %}
  <p class="na">NON-DIAGNOSTIC movement assessment. Items are potential movement-related risk factors, not diagnoses.</p>
  {% if v.n.s10_injury.risks %}
  <table><tr><th>Risk Factor</th><th>Evidence</th><th>Possible Concern</th><th>Severity</th><th>Corrective Strategy</th><th>Confidence</th></tr>
  {% for r in v.n.s10_injury.risks %}<tr><td>{{ r.factor }}</td><td>{{ txt(r.evidence) }}</td><td>{{ r.possible_concern }}</td><td><span class="chip sev-{{ r.severity }}">{{ r.severity }}</span></td><td>{{ r.corrective_strategy }}</td><td>{{ conf(r.confidence) }}</td></tr>{% endfor %}</table>
  {% else %}<p class="na">No movement-related risk factor could be established from the available evidence.</p>{% endif %}

{% elif k == "s11" %}
  <table><tr><th>Category</th><th>Score /10</th><th>Evidence</th><th>Main Limitation</th><th>Coaching Recommendation</th></tr>
  {% for c in v.framework %}<tr><td>{{ c.label }}</td><td>{{ score(c.score) }} {{ conf(c.confidence) }}</td><td>{{ txt(c.evidence) }}</td><td>{{ txt(c.main_limitation) }}</td><td>{{ txt(c.recommendation) }}</td></tr>{% endfor %}</table>

{% elif k == "s12" %}{% set sc = v.n.s12_scorecard %}
  <table><tr><th>Item</th><th>Score</th><th>Justification</th><th>Confidence</th></tr>
  {% for p in sc.phases %}<tr><td>{{ p.phase_name }}</td><td>{{ score(p.score) }}</td><td>{{ txt(p.justification) }}</td><td>{{ conf(p.confidence) }}</td></tr>{% endfor %}
  {% for key, label in [("shot_consistency","Shot consistency"),("biomechanical_efficiency","Biomechanical efficiency"),("movement_stability","Movement stability"),("overall_technique","Overall technique")] %}
  <tr><th>{{ label }}</th><td>{{ score(sc[key].score) }}</td><td>{{ txt(sc[key].justification) }}</td><td>{{ conf(sc[key].confidence) }}</td></tr>{% endfor %}</table>

{% elif k == "s13" %}
  {% for i in v.n.s13_strengths["items"] %}<div class="prio"><b>{{ loop.index }}. {{ i.strength }}</b> <span class="chip" id="{{ i.id }}">{{ i.id }}</span> {{ conf(i.confidence) }}
  <div><b>Evidence:</b> {{ txt(i.evidence) }}</div><div><b>Biomechanical reason:</b> {{ i.biomechanical_reason }}</div>
  <div><b>Performance benefit:</b> {{ i.performance_benefit }}</div><div><b>Maintenance strategy:</b> {{ i.maintenance_strategy }}</div></div>{% endfor %}
  {% if v.n_strengths < 10 %}<p><b>Only {{ v.n_strengths }} strengths could be reliably established from the available video.</b></p>{% endif %}

{% elif k == "s14" %}
  {% for i in v.n.s14_weaknesses["items"]|sort(attribute="rank") %}<div class="prio"><b>{{ i.rank }}. {{ i.weakness }}</b> <span class="chip" id="{{ i.id }}">{{ i.id }}</span> {{ conf(i.confidence) }} <span class="chip">Priority {{ i.priority }}</span>
  <div><b>Evidence:</b> {{ txt(i.evidence) }}</div><div><b>Likely cause:</b> {{ i.likely_cause }}</div>
  <div><b>Performance consequence:</b> {{ i.performance_consequence }}</div><div><b>Correction:</b> {{ i.correction }}</div></div>{% endfor %}

{% elif k == "s15" %}
  {% for p in v.n.s15_priorities.priorities|sort(attribute="rank") %}<div class="prio">
  <h3>PRIORITY #{{ p.rank }} - {{ p.issue }} <span class="chip">{{ p.weakness_ref }}</span> {{ conf(p.confidence) }}</h3>
  <table>
  {% for f, label in [("current_problem","Current problem"),("evidence","Evidence"),("timestamp","Timestamp"),("shot_phase","Shot phase"),("why_it_matters","Why it matters"),("biomechanical_consequence","Biomechanical consequence"),("performance_consequence","Performance consequence"),("corrective_strategy","Corrective strategy"),("technical_drill","Technical drill"),("sets","Sets"),("repetitions","Repetitions"),("frequency","Frequency"),("progression","Progression"),("success_metric","Success metric")] %}
  <tr><th style="width:28%">{{ label }}</th><td>{{ txt(p[f]) }}</td></tr>{% endfor %}</table></div>{% endfor %}

{% elif k == "s16" %}{% set t = v.n.s16_training_coaching %}
  {% for grp, label in [("technical","A. TECHNICAL TRAINING"),("strength_conditioning","B. STRENGTH & CONDITIONING"),("mental","C. MENTAL TRAINING"),("warm_up","D. WARM-UP")] %}
  <h3>{{ label }}</h3>
  {% if t[grp] %}<table><tr><th>Purpose</th><th>Exercise/Drill</th><th>Sets</th><th>Repetitions</th><th>Frequency</th><th>Coaching Cue</th><th>Progression</th><th>Addresses</th></tr>
  {% for r in t[grp] %}<tr><td>{{ r.purpose }}</td><td>{{ r.exercise }}</td><td>{{ r.sets }}</td><td>{{ r.repetitions }}</td><td>{{ r.frequency }}</td><td>{{ r.coaching_cue }}</td><td>{{ r.progression }}</td><td>{{ r.addresses|join(", ") }}</td></tr>{% endfor %}</table>
  {% else %}<p class="na">No recommendation: no identified deficiency in this area.</p>{% endif %}{% endfor %}

{% elif k == "s17" %}{% set t = v.n.s16_training_coaching %}
  {% for grp, label in [("immediate","IMMEDIATE - Next training sessions"),("short_term","SHORT TERM - Next 2-4 weeks"),("long_term","LONG TERM - Next 2-3 months")] %}
  <h3>{{ label }}</h3><ul>{% for r in t[grp] %}<li>{{ r.recommendation }} <span class="chip">{{ r.addresses|join(", ") }}</span></li>{% endfor %}</ul>{% endfor %}

{% elif k == "s18" %}
  <table><tr><th>Aspect</th><th>Projection</th><th>Confidence</th></tr>
  {% for p in v.n.s18_projection_final.projection %}<tr><td>{{ p.aspect }}</td><td>{{ txt(p.projection) }}</td><td>{{ conf(p.confidence) }}</td></tr>{% endfor %}</table>
  <p class="na">No score improvement is guaranteed; no numerical performance gain is stated without baseline performance data.</p>

{% elif k == "s19" %}{% set f = v.n.s18_projection_final %}
  <h3>3 THINGS THE ARCHER DOES WELL</h3><ol>{% for i in f.does_well %}<li>{{ i.text }} <span class="chip">{{ i.ref }}</span></li>{% endfor %}</ol>
  <h3>3 THINGS TO FIX FIRST</h3><ol>{% for i in f.fix_first %}<li>{{ i.text }} <span class="chip">{{ i.ref }}</span></li>{% endfor %}</ol>
  <h3>SINGLE MOST IMPORTANT CORRECTION</h3><p>{{ f.single_correction.text }} <span class="chip">{{ f.single_correction.ref }}</span></p>
  <h3>KEY COACHING CUE</h3><p class="cue">"{{ f.key_cue }}"</p>
  <h3>FINAL ASSESSMENT</h3><p>{{ f.final_assessment }}</p>

{% elif k == "s20" %}
  <table><tr><th>Level</th><th>Definition</th><th>Items in this report</th></tr>
  <tr><td>{{ conf("HIGH") }}</td><td>Clearly visible and/or reliably measured.</td><td class="num">{{ v.conf_counts.HIGH }}</td></tr>
  <tr><td>{{ conf("MEDIUM") }}</td><td>Reasonably supported but limited by video quality.</td><td class="num">{{ v.conf_counts.MEDIUM }}</td></tr>
  <tr><td>{{ conf("LOW") }}</td><td>Possible interpretation but insufficient evidence.</td><td class="num">{{ v.conf_counts.LOW }}</td></tr></table>
  <p>LOW-confidence observations are never presented as definitive conclusions. Every number in this report is substituted from the measured evidence file; the narrative contains no typed measurements.</p>
  <h3>Consistency control (automated verification)</h3>
  <table><tr><th>Check</th><th>Result</th></tr>{% for c in v.checklist %}<tr><td>{{ c.check }}</td><td><span class="chip c-{{ 'HIGH' if c.status == 'PASS' else 'LOW' }}">{{ c.status }}</span></td></tr>{% endfor %}</table>
  <h3>Provenance</h3>
  <div class="kv">{% for k2, val in v.provenance %}<div>{{ k2 }}</div><div>{{ val }}</div>{% endfor %}</div>

{% elif k == "p1" %}
  {% set ph = v.physio %}
  <h3>Inputs supplied for this session</h3>
  <table><tr><th>Input</th><th>Status</th><th>Detail</th></tr>
  {% for i in ph.inventory %}<tr><td>{{ i.input }}</td>
    <td><span class="chip c-{{ 'HIGH' if i.status == 'SUPPLIED' else 'LOW' }}">{{ i.status }}</span></td>
    <td>{{ i.detail }}</td></tr>{% endfor %}
  {% if not ph.inventory %}<tr><td colspan="3" class="na">No athlete or physiological inputs were entered.</td></tr>{% endif %}
  </table>

  {% if ph.anthro.height_cm or ph.anthro.weight_kg or ph.anthro.age_y %}
  <h3>Anthropometrics</h3>
  <div class="kv">
    <div>Height</div><div>{{ ph.anthro.height_cm or "NOT PROVIDED" }}{% if ph.anthro.height_cm %} cm{% endif %}</div>
    <div>Weight</div><div>{{ ph.anthro.weight_kg or "NOT PROVIDED" }}{% if ph.anthro.weight_kg %} kg{% endif %}</div>
    <div>Age</div><div>{{ ph.anthro.age_y or "NOT PROVIDED" }}{% if ph.anthro.age_y %} years{% endif %}</div>
    <div>BMI</div><div>{% if ph.anthro.bmi %}{{ ph.anthro.bmi }} kg/m<sup>2</sup>
      <span class="muted">computed as {{ ph.anthro.bmi_formula }}</span>{% else %}NOT PROVIDED{% endif %}</div>
  </div>
  <p class="muted">BMI is reported as a computed number only. No health, body-composition or
  weight-category reading is attached to it. Source: {{ ph.anthro.bmi_source }}</p>
  {% if ph.anthro.is_youth_athlete %}
  <p><span class="chip c-MEDIUM">YOUTH ATHLETE</span> Age is below {{ ph.anthro.youth_threshold_y }}.
  Training volume, load progression and recovery in this report follow youth guidelines and
  require coach sign-off before use. Source: {{ ph.anthro.youth_source }}</p>
  {% endif %}
  {% endif %}

  {% if ph.hr_supplied %}
  <h3>Heart rate</h3>
  <div class="kv">
    <div>Resting</div><div>{{ ph.hr.rest_bpm or "NOT PROVIDED" }}{% if ph.hr.rest_bpm %} bpm{% endif %}</div>
    <div>Session average</div><div>{{ ph.hr.mean_bpm or "NOT PROVIDED" }}{% if ph.hr.mean_bpm %} bpm{% endif %}</div>
    <div>Highest observed</div><div>{{ ph.hr.max_observed_bpm or "NOT PROVIDED" }}{% if ph.hr.max_observed_bpm %} bpm{% endif %}</div>
    <div>Age-predicted maximum</div><div>{% if ph.hr.max_estimated_bpm %}{{ ph.hr.max_estimated_bpm }} bpm
      <span class="chip c-MEDIUM">ESTIMATE</span>{% else %}NOT PROVIDED{% endif %}</div>
  </div>
  {% if ph.hr.zones %}
  <table><tr><th>Zone</th><th>Intensity</th><th>% of estimated maximum</th><th>Range</th></tr>
  {% for z in ph.hr.zones %}<tr><td>{{ z.zone }}</td><td>{{ z.name }}</td>
    <td class="num">{{ z.low_pct }}&ndash;{{ z.high_pct }}%</td>
    <td class="num">{{ z.low_bpm }}&ndash;{{ z.high_bpm }} bpm</td></tr>{% endfor %}</table>
  <p class="muted">Every boundary above is an ESTIMATE derived from
  {{ ph.hr.max_formula }} ({{ ph.hr.max_label }}), not a measured threshold. An individual
  maximum can differ from the formula by roughly ten beats per minute either way.<br>
  Maximum: {{ ph.hr.max_source }}<br>Zones: {{ ph.hr.zones_source }}</p>
  {% endif %}
  {% endif %}

  {% if ph.p1 %}
  <h3>Assessment</h3>
  <ul>{% for s in ph.p1.summary %}<li>{{ s.point }} {{ lvl(s.evidence_level) }} {{ conf(s.confidence) }}</li>{% endfor %}</ul>
  <p>{{ ph.p1.zone_statement }}</p>
  <p><b>Working heart rate relative to the band this shot cycle needs:</b>
     <span class="chip c-{{ 'LOW' if ph.p1.working_hr_direction == 'NOT ASSESSABLE' else 'MEDIUM' }}">{{ ph.p1.working_hr_direction }}</span></p>
  {% if ph.p1.actions %}
  <table><tr><th>Action</th><th>Purpose</th></tr>
  {% for a in ph.p1.actions %}<tr><td>{{ a.action }}</td><td>{{ a.purpose }}</td></tr>{% endfor %}</table>
  {% endif %}
  <p class="muted">{{ ph.p1.estimate_caveat }}</p>
  {% for c in ph.p1.caveats %}<p class="muted">{{ c }}</p>{% endfor %}
  <p class="muted">This section covers training load, pacing, breathing and recovery only. It is
  not a clinical assessment and names no medical condition.</p>
  {% elif not ph.hr_supplied %}
  <p class="na">NOT PROVIDED - CANNOT BE CONFIRMED. No heart-rate data was supplied with this session.</p>
  {% endif %}

{% elif k == "p2" %}
  {% set ph = v.physio %}
  {% if ph.plate_supplied %}
  <p>Source: <b>{{ ph.plate.file }}</b>, matched to <b>{{ ph.plate.athlete_matched }}</b>
     ({{ ph.plate.rows_for_this_athlete }} of {{ ph.plate.rows_in_file }} trials in the file;
     {{ ph.plate.other_athletes_in_file }} other athlete(s) in the same export were not read).
     SHA-256 {{ ph.plate.sha256[:16] }}.</p>
  {% if ph.plate.anthropometric_conflicts %}
  <p><span class="chip c-LOW">DISAGREEMENT</span>
  {% for c in ph.plate.anthropometric_conflicts %}{{ c }}. {% endfor %}
  The entered value was used for this run and is not silently replaced.</p>
  {% endif %}
  <h3>Trial conditions</h3>
  <table><tr><th>Condition</th><th>Task</th><th>Stance</th><th>Duration</th><th>Trials</th></tr>
  {% for c in ph.plate.conditions %}<tr><td>{{ c.condition }}</td><td>{{ c.definition.upper }}</td>
    <td>{{ c.definition.stance }}</td><td class="num">{{ c.definition.duration_s }} s</td>
    <td class="num">{{ c.n_trials }}</td></tr>{% endfor %}</table>
  <p class="muted">Conditions differ in task and duration, so values are never averaged or
  compared across them. The condition is part of every evidence key.</p>

  <h3>Postural measures</h3>
  <table><tr><th>Condition</th><th>Measure</th><th>Mean</th><th>SD</th><th>n</th></tr>
  {% for r in ph.plate_rows %}<tr><td>{{ r.condition }}</td><td>{{ r.measure }}</td>
    <td class="num">{{ r.mean }} {{ r.units }}</td>
    <td class="num">{% if r.sd is none %}<span class="muted">withheld, fewer than {{ ph.plate.min_trials_for_sd }} trials</span>{% else %}{{ r.sd }}{% endif %}</td>
    <td class="num">{{ r.n }}</td></tr>{% endfor %}</table>

  {% if ph.plate.unavailable_measures %}
  <h3>Measures the instrument did not record</h3>
  <table><tr><th>Measure</th><th>Reason</th></tr>
  {% for name, why in ph.plate.unavailable_measures.items() %}<tr><td>{{ name.replace("_", " ") }}</td><td>{{ why }}</td></tr>{% endfor %}</table>
  <p class="muted">These channels are reported as unavailable rather than as zero. Reading a
  zero here as perfect left/right symmetry would be a fabricated finding.</p>
  {% endif %}
  {% endif %}

  {% if ph.images %}
  <h3>Force-plate report figures</h3>
  {% for im in ph.images %}
  <figure><img src="data:image/jpeg;base64,{{ im.b64 }}" alt="Force-plate figure {{ im.name }}">
  <figcaption>{{ im.name }}. Shown as supplied. No value in this report is read from an image.</figcaption></figure>
  {% endfor %}
  {% endif %}

  {% if ph.p2 %}
  <h3>Where the plate and the video agree</h3>
  {% if ph.p2.agreements %}
  <table><tr><th>Finding</th><th>Video basis</th><th>Confidence</th></tr>
  {% for a in ph.p2.agreements %}<tr><td>{{ a.finding }}</td><td>{{ a.video_basis }}</td><td>{{ conf(a.confidence) }}</td></tr>{% endfor %}</table>
  {% else %}<p class="na">No measure was corroborated by both sources.</p>{% endif %}
  <h3>Where they conflict</h3>
  {% if ph.p2.conflicts %}
  <table><tr><th>Finding</th><th>Video basis</th><th>Confidence</th></tr>
  {% for a in ph.p2.conflicts %}<tr><td>{{ a.finding }}</td><td>{{ a.video_basis }}</td><td>{{ conf(a.confidence) }}</td></tr>{% endfor %}</table>
  {% else %}<p>None.</p>{% endif %}
  {% if ph.p2.interventions %}
  <h3>Interventions addressing both</h3>
  <table><tr><th>Intervention</th><th>Addresses</th></tr>
  {% for i in ph.p2.interventions %}<tr><td>{{ i.intervention }}</td><td>{{ i.addresses }}</td></tr>{% endfor %}</table>
  {% endif %}
  {% for t in ph.p2.not_assessed %}<p class="muted">{{ t }}</p>{% endfor %}
  {% elif not ph.plate_supplied %}
  <p class="na">NOT PROVIDED - CANNOT BE CONFIRMED. No force-plate export was supplied with this session.</p>
  {% endif %}
{% endif %}
</div></details>
</section>
{% endfor %}
<footer>Generated by the SAI archery biomechanics pipeline &middot; {{ v.generated }}</footer>
</main>
<script>
(function(){
var btn=document.getElementById('toggle'),open=false;
btn.addEventListener('click',function(){open=!open;
 document.querySelectorAll('details').forEach(function(d){d.open=open});
 btn.textContent=open?'Collapse all':'Expand all'});
function reveal(id){var el=document.getElementById(id);if(!el)return;
 for(var p=el.parentElement;p;p=p.parentElement){if(p.tagName==='DETAILS')p.open=true}
 el.scrollIntoView({block:'center'})}
document.addEventListener('click',function(e){var a=e.target.closest('a[href^="#"]');
 if(a&&a.closest('main')){e.preventDefault();reveal(a.getAttribute('href').slice(1))}});
})();
</script>
</body>
</html>
