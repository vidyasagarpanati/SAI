<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}SAI Archery{% endblock %}</title>
<style>
:root{--ink:#1d2330;--muted:#5d6678;--line:#dfe3ea;--bg:#f6f7fa;--card:#fff;--accent:#1f4e79;
--hi:#1e7d4f;--me:#b7791f;--lo:#b8322a;--chip:#eef1f6;--run:#2a78d6}
*{box-sizing:border-box}
body{margin:0;font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
color:var(--ink);background:var(--bg)}
header.top{background:linear-gradient(120deg,#12324f,#1f4e79);color:#fff;padding:18px 28px;
display:flex;align-items:baseline;gap:22px;flex-wrap:wrap}
header.top h1{margin:0;font-size:19px;letter-spacing:.3px;font-weight:650}
header.top nav a{color:#cfe0f0;text-decoration:none;font-size:14px;margin-right:16px}
header.top nav a:hover,header.top nav a.on{color:#fff;text-decoration:underline}
header.top .right{margin-left:auto;font-size:12.5px;opacity:.8}
main{max-width:1180px;margin:0 auto;padding:18px 16px 60px}
section{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px 22px;margin:16px 0}
h2{margin:0 0 10px;font-size:18px;color:var(--accent);border-bottom:2px solid var(--line);padding-bottom:7px}
h3{font-size:15px;margin:18px 0 6px}
table{border-collapse:collapse;width:100%;margin:8px 0 12px;font-size:13.5px}
th,td{border:1px solid var(--line);padding:6px 9px;text-align:left;vertical-align:middle}
th{background:var(--chip);font-weight:600}
td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
a{color:var(--accent)}
.btn{display:inline-block;background:var(--accent);color:#fff;border:0;border-radius:7px;
padding:8px 15px;font:inherit;font-size:14px;cursor:pointer;text-decoration:none}
.btn:hover{background:#17405f}
.btn.sm{padding:4px 10px;font-size:12.5px}
.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--line)}
.btn.warn{background:var(--lo)}
.btn[disabled]{background:#aab;cursor:not-allowed}
.chip{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:10px;background:var(--chip);color:#334}
.s-DONE{background:#e3f4ec;color:var(--hi)}.s-RUNNING{background:#e4eefb;color:var(--run)}
.s-FAILED{background:#fbe6e4;color:var(--lo)}.s-PENDING{background:#eef1f6;color:#667}
.s-QUEUED{background:#fbf1de;color:var(--me)}.s-CANCELLED{background:#eceef2;color:#667}
.na{color:var(--muted);font-style:italic}
.muted{color:var(--muted);font-size:12.5px}
.bar{height:4px;background:var(--line);border-radius:2px;margin-top:5px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--run);border-radius:2px;transition:width .4s}
.bar.DONE i{background:var(--hi)}.bar.FAILED i{background:var(--lo)}.bar.CANCELLED i{background:var(--muted)}
.dots{display:inline-flex;gap:3px}
.dot{width:9px;height:9px;border-radius:2px;background:#dfe3ea;display:inline-block}
.dot.DONE{background:var(--hi)}.dot.RUNNING{background:var(--run)}.dot.FAILED{background:var(--lo)}
.banner{background:#fff4e5;border:1px solid #f0d3a5;border-left:6px solid var(--me);
border-radius:8px;padding:11px 15px;margin:10px 0;font-size:13.5px}
.banner.bad{background:#fdf3f2;border-color:#f0c5c0;border-left-color:var(--lo)}
.banner.good{background:#eef8f2;border-color:#c3e4d2;border-left-color:var(--hi)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px 18px}
label.f{display:block;font-size:12.5px;color:var(--muted);margin:9px 0 2px}
input[type=text],input[type=number],input[type=date],select,textarea{width:100%;padding:7px 9px;
border:1px solid var(--line);border-radius:6px;font:inherit;font-size:14px;background:#fff;color:var(--ink)}
textarea{min-height:104px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px}
.pick{max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:7px;padding:4px 10px}
.pick label{display:flex;gap:9px;align-items:center;padding:5px 0;font-size:13.5px;border-bottom:1px solid #f1f3f7}
.pick label:last-child{border-bottom:0}
pre.log{background:#10151d;color:#d6dde8;border-radius:8px;padding:12px 14px;font-size:12px;
line-height:1.5;max-height:340px;overflow:auto;margin:8px 0;white-space:pre-wrap}
.frames{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:9px}
.frames img{width:100%;border-radius:6px;border:1px solid var(--line)}
footer{color:var(--muted);font-size:12px;text-align:center;margin-top:28px}
@media (max-width:720px){header.top{padding:14px 16px}section{padding:14px}}
</style>
</head>
<body>
<header class="top">
  <h1>SAI Archery</h1>
  <nav>
    <a href="/" class="{{ 'on' if nav == 'library' }}">Runs</a>
    <a href="/new" class="{{ 'on' if nav == 'new' }}">Analyse a video</a>
    <a href="/jobs" class="{{ 'on' if nav == 'jobs' }}">Queue{% if active_jobs %} ({{ active_jobs|length }}){% endif %}</a>
    <a href="/doctor" class="{{ 'on' if nav == 'doctor' }}">Environment</a>
  </nav>
  <div class="right">v{{ version }}{% if video_folder %} &middot; watching {{ video_folder }}{% endif %}</div>
</header>
<main>
{% block body %}{% endblock %}
<footer>Local only, bound to 127.0.0.1. This page serves what the pipeline produced; it computes nothing.</footer>
</main>
{% block script %}{% endblock %}
</body>
</html>
